# Supabase credentials for the pre-launch waitlist form on /recallguard.
#
# These are baked into the client bundle at build time, which is what the anon
# key is designed for — it can insert into public.waitlist and nothing else,
# because that table has an insert-only policy and no select policy.
#
# Set the same two values in the Cloudflare dashboard under
# Workers & Pages -> azcstudios.com -> Settings -> Variables, or the deployed
# build ships without a working form. WaitlistForm degrades to the old
# "Coming to the App Store" chip when they are missing, so a misconfigured
# build is quiet rather than broken.
#
# Values live in the RecallGuard project: Supabase dashboard -> Project
# Settings -> API. Do not paste the service_role key here; it is not needed
# and must never reach a client bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
